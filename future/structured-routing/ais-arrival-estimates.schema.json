{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saaristolautat.fi/schema/ais-arrival-estimates-v1.json",
  "title": "Saaristolautat historical AIS arrival estimates",
  "type": "object",
  "required": ["schemaVersion", "status", "modelVersion", "timezone", "weekday", "policy", "routes"],
  "$defs": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "clock": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "minuteRange": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "variant": {
      "type": "object",
      "required": ["via", "sampleSize", "minutes", "observedFrom", "observedTo"],
      "properties": {
        "via": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sampleSize": { "type": "integer", "minimum": 5 },
        "minutes": { "$ref": "#/$defs/minuteRange" },
        "observedFrom": { "$ref": "#/$defs/date" },
        "observedTo": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": ["stop", "sampleSize", "observedFrom", "observedTo", "status", "typicalMinutes", "possibleMinutes", "variants"],
      "properties": {
        "stop": { "type": "string" },
        "sampleSize": { "type": "integer", "minimum": 5 },
        "observedFrom": { "$ref": "#/$defs/date" },
        "observedTo": { "$ref": "#/$defs/date" },
        "status": { "enum": ["compact", "wide_route_alternatives", "wide_within_variant"] },
        "typicalMinutes": { "$ref": "#/$defs/minuteRange" },
        "possibleMinutes": { "$ref": "#/$defs/minuteRange" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      },
      "additionalProperties": false
    },
    "departure": {
      "type": "object",
      "required": ["from", "weekday", "time", "sampleSize", "observedFrom", "observedTo", "destinations"],
      "properties": {
        "from": { "type": "string" },
        "weekday": { "type": "integer", "minimum": 0, "maximum": 6 },
        "time": { "$ref": "#/$defs/clock" },
        "sampleSize": { "type": "integer", "minimum": 3 },
        "observedFrom": { "$ref": "#/$defs/date" },
        "observedTo": { "$ref": "#/$defs/date" },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/destination" }
        }
      },
      "additionalProperties": false
    },
    "pooledPath": {
      "type": "object",
      "required": ["from", "stop", "via", "sampleSize", "minutes", "observedFrom", "observedTo", "vesselCount"],
      "properties": {
        "from": { "type": "string" },
        "stop": { "type": "string" },
        "via": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sampleSize": { "type": "integer", "minimum": 5 },
        "minutes": { "$ref": "#/$defs/minuteRange" },
        "observedFrom": { "$ref": "#/$defs/date" },
        "observedTo": { "$ref": "#/$defs/date" },
        "vesselCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "draft" },
    "modelVersion": { "const": "ais-driving-v1" },
    "timezone": { "const": "Europe/Helsinki" },
    "weekday": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "string" }
    },
    "policy": {
      "type": "object",
      "required": ["basis", "role", "scheduledTimesTakePrecedence", "intermediateWaitsIncluded", "minimumDepartureSamples", "minimumVariantSamples"],
      "properties": {
        "basis": { "const": "historical_ais_observations" },
        "role": { "const": "advisory" },
        "scheduledTimesTakePrecedence": { "const": true },
        "intermediateWaitsIncluded": { "const": false },
        "minimumDepartureSamples": { "type": "integer", "minimum": 1 },
        "minimumVariantSamples": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "departures", "pooledPaths"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "departures": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/departure" }
          },
          "pooledPaths": {
            "type": "array",
            "items": { "$ref": "#/$defs/pooledPath" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
