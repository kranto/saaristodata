{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saaristolautat.fi/schemas/route-request.schema.json",
  "title": "Saaristolautat address route request",
  "type": "object",
  "required": ["origin", "destination", "date"],
  "properties": {
    "origin": { "type": "string", "minLength": 2, "maxLength": 300 },
    "destination": { "type": "string", "minLength": 2, "maxLength": 300 },
    "date": { "type": "string", "format": "date" },
    "startTime": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-9]{2}$",
      "default": "00:00"
    },
    "mode": {
      "enum": ["car", "motorcycle", "bicycle"],
      "default": "car"
    },
    "timingProfile": {
      "enum": ["typical", "conservative"],
      "default": "typical"
    },
    "sameDay": { "type": "boolean", "default": true },
    "maxResults": { "type": "integer", "minimum": 1, "maximum": 24, "default": 12 },
    "includeDiagnostics": { "type": "boolean", "default": false },
    "includeGeometry": { "type": "boolean", "default": true }
  },
  "additionalProperties": false
}
